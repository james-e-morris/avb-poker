{
  "name": "avb-poker",
  "version": "1.0.0",
  "description": "AVB Planning Poker - GitHub Pages Deployment",
  "scripts": {
    "test": "jest --config=config/jest.config.js --coverage",
    "test:watch": "jest --config=config/jest.config.js --watch",
    "test:coverage": "jest --config=config/jest.config.js --coverage --collectCoverageFrom='src/js/app-exports.js'",
    "test:e2e": "playwright test --config=config/playwright.config.js --ui",
    "test:e2e:headless": "playwright test --config=config/playwright.config.js",
    "serve": "python -m http.server 8000"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  }
}
